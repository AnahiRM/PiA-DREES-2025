    "\n",
    "from tavily import TavilyClient\n",
    "import pandas as pd\n",
    "import json\n",
    "\n",
    "\n",
    "tavily_client = TavilyClient(api_key=\"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\")"
